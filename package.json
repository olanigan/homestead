{
  "name": "homestead-ai",
  "version": "0.0.4",
  "description": "Your Local AI Harness",
  "author": "Ibrahim Olanigan",
  "type": "module",
  "bin": {
    "homestead": "dist/homestead.js"
  },
  "main": "dist/types.js",
  "types": "dist/types.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.json",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/types.js",
    "./registry": "./dist/core/registry.js",
    "./hf-download": "./dist/core/hf-download.js"
  },
  "scripts": {
    "build": "npm run build:ui && tsc",
    "build:ui": "cd src/ui/frontend && npm run build",
    "build:ts": "tsc",
    "dev": "tsc --watch",
    "start": "bun dist/homestead.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "test": "bun test --timeout 120000",
    "test:unit": "bun test --timeout 120000 tests/unit",
    "test:e2e": "bun test --timeout 120000 tests/e2e",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@huggingface/hub": "^2.13.3",
    "commander": "^13.1.0",
    "hono": "^4.7.5",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@types/bun": "^1.2.9",
    "@types/node": "^25.9.3",
    "eslint": "^10.8.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "license": "Apache-2.0 OR MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olanigan/homestead.git"
  },
  "homepage": "https://homesteadai.dev",
  "keywords": [
    "llm",
    "local-ai",
    "ollama",
    "llamacpp",
    "mlx",
    "model-registry",
    "cli"
  ]
}
